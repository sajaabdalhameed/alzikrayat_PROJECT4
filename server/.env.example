# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alzikrayat
# Local MongoDB alternative (uncomment and use instead of the line above):
# MONGODB_URI=mongodb://127.0.0.1:27017/alzikrayat

PORT=5000
JWT_SECRET=replace_with_a_long_random_string
# Track F (AI). Leave empty to run the app in demo mode without calling OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

